# ==========================================
# Godot 核心缓存（不提交）
# ==========================================
.godot/

# ==========================================
# C# / .NET 编译产物（不提交）
# ==========================================
bin/
obj/
.mono/
*.csproj.user

# ==========================================
# 插件
# ==========================================
# 运行时必需的轻量插件随仓库提交（VAT 动画、AI Context 等）
# GodotGit 仅为编辑器工具，不提交
addons/godot-git-plugin/
# GodotSteam 体积约 110MB，按需手动安装；单机模式（--offline）不依赖
addons/godotsteam/

# ==========================================
# 本地备份 / 日志 / 临时文件
# ==========================================
logs/
.refactor_backup_*/
*.tmp
# AI/调试会话留下的日志（根目录散落一堆，不该进仓库）
ais_*.log
ai_*.log
*.log
tmp/

# ==========================================
# Godot 导出模板（约 1.2GB，引擎工具而非项目内容）
# ==========================================
# 它由 Godot 编辑器管理、每台机器本地安装一次即可，
# 提交进来会让仓库膨胀到无法 clone。
export_templates/

# ==========================================
# IDE 生成文件
# ==========================================
.vs/
.idea/
.vscode/

# ==========================================
# 根目录大体积下载包
# ==========================================
/RTSarcade_source_*.zip
/Turret Pack*.zip

# ==========================================
# 打包导出配置（如含密钥请自行决定是否提交）
# ==========================================
# export_presets.cfg

# ==========================================
# 操作系统自动生成文件
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ==========================================
# VAT 烘焙数据（139MB，当前不可达）
# ==========================================
# 审计确认：IsBatchableModel 永远返回 false（没有单位引用已烘焙的模型），
# 所以这批数据在运行期完全用不到。
# 烘焙工具 Tools/VatBakeTool.gd 仍在仓库里，需要时可重建。
Data/VAT/
